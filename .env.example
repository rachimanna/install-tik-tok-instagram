# Обязательно: токен от @BotFather
BOT_TOKEN=

# --- Необязательные настройки (значения по умолчанию указаны) ---

# Режим: polling (VPS, Codespaces) или webhook (Render Web Service)
BOT_MODE=polling
# Для webhook: публичный https-адрес. На Render берётся из RENDER_EXTERNAL_URL автоматически.
WEBHOOK_BASE_URL=
# Для webhook: любая случайная строка (из неё выводится секретный токен)
WEBHOOK_SECRET=
PORT=8080

# Свой локальный Telegram Bot API сервер (https://github.com/tdlib/telegram-bot-api).
# Нужен только чтобы отправлять файлы больше 50 МБ. Пример: http://127.0.0.1:8081
TELEGRAM_API_URL=
# Лимит размера отправляемого файла в МБ. Облачный Bot API: 50. Локальный сервер: до 2000.
MAX_UPLOAD_MB=50

# Ограничения нагрузки
MAX_CONCURRENT_DOWNLOADS=3
MAX_TASKS_PER_USER=1
DOWNLOAD_TIMEOUT_SECONDS=180
SEND_TIMEOUT_SECONDS=300
MAX_ITEMS_PER_POST=10

# Сколько минут хранить скачанный файл для кнопки «Скачать оригинальным файлом»
FILE_TTL_MINUTES=60
# Максимальный суммарный размер кэша файлов, МБ
CACHE_MAX_MB=2000
# Рабочая папка для временных файлов
WORK_DIR=./data

# Если чистой версии TikTok нет — отправлять версию с водяным знаком (с явной пометкой)
TIKTOK_ALLOW_WATERMARK_FALLBACK=true

# Необязательно: cookies.txt (формат Netscape) ВАШЕГО служебного аккаунта для yt-dlp.
# Помогает, если Instagram/TikTok требуют вход. Пароли пользователей бот не запрашивает.
YTDLP_COOKIES_FILE=
# Необязательно: прокси для yt-dlp, например socks5://user:pass@host:1080
YTDLP_PROXY=

LOG_LEVEL=INFO
